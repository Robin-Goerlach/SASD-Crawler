# SASD-Crawler project-specific Codex execpolicy rules
#
# Broad rule: routine Git, dotnet, GitHub CLI, repository reads and searches
# should run autonomously. Narrower prompt rules protect explicitly risky
# variants. Codex applies the strictest decision across all matching rules.
#
# IMPORTANT: prefix_rule is prefix-based. AGENTS.md and RULES.md therefore
# require risky `git push` flags to be placed immediately after `git push`
# so the prompt override cannot be bypassed accidentally by argument order.

# ---------------------------------------------------------------------------
# Broad autonomous development
# ---------------------------------------------------------------------------

prefix_rule(
    pattern = ["git"],
    decision = "allow",
    justification = "Allow normal autonomous Git work in the trusted SASD-Crawler repository.",
    match = [
        "git status",
        "git branch",
        "git fetch",
        "git pull --ff-only",
        "git rev-parse HEAD",
        "git describe --tags --always",
        "git add .",
        "git commit -m test",
        "git push",
    ],
)

prefix_rule(
    pattern = ["dotnet"],
    decision = "allow",
    justification = "Allow normal autonomous .NET work for SASD-Crawler, including restore, build, test and publish.",
    match = [
        "dotnet restore",
        "dotnet build",
        "dotnet test",
        "dotnet publish",
        "dotnet format",
    ],
)

prefix_rule(
    pattern = ["gh"],
    decision = "allow",
    justification = "Allow normal autonomous GitHub CLI work in the trusted SASD-Crawler repository.",
    match = [
        "gh pr view 1",
        "gh pr checks 1",
        "gh pr create --fill",
        "gh run view 123",
        "gh run watch 123",
        "gh release view",
        "gh release create v0.0.1",
        "gh release upload v0.0.1 artifact.zip",
    ],
)

# ---------------------------------------------------------------------------
# Read-only PowerShell / repository inspection
# ---------------------------------------------------------------------------

prefix_rule(
    pattern = ["Get-Content"],
    decision = "allow",
    justification = "Allow Codex to read SASD-Crawler source, documentation and evidence files without approval.",
)

prefix_rule(
    pattern = ["Get-ChildItem"],
    decision = "allow",
    justification = "Allow Codex to inspect the SASD-Crawler repository file tree without approval.",
)

prefix_rule(
    pattern = ["Get-Item"],
    decision = "allow",
    justification = "Allow Codex to inspect SASD-Crawler filesystem metadata without approval.",
)

prefix_rule(
    pattern = ["Test-Path"],
    decision = "allow",
    justification = "Allow Codex to test paths during SASD-Crawler development.",
)

prefix_rule(
    pattern = ["Resolve-Path"],
    decision = "allow",
    justification = "Allow Codex to resolve paths during SASD-Crawler development.",
)

prefix_rule(
    pattern = ["Get-FileHash"],
    decision = "allow",
    justification = "Allow Codex to verify SASD-Crawler release, package and backup checksums without approval.",
)

prefix_rule(
    pattern = ["Select-String"],
    decision = "allow",
    justification = "Allow Codex to search text in SASD-Crawler files without approval.",
)

prefix_rule(
    pattern = ["rg"],
    decision = "allow",
    justification = "Allow ripgrep repository searches without approval.",
)

# ---------------------------------------------------------------------------
# Git: explicit risky variants require approval
# ---------------------------------------------------------------------------

prefix_rule(
    pattern = ["git", "reset"],
    decision = "prompt",
    justification = "Reset can discard or rewrite local repository state; ask before running it.",
)

prefix_rule(
    pattern = ["git", "clean"],
    decision = "prompt",
    justification = "Git clean can permanently remove untracked files; ask before running it.",
)

prefix_rule(
    pattern = ["git", "rebase"],
    decision = "prompt",
    justification = "Rebase can rewrite commit history; ask before running it.",
)

prefix_rule(
    pattern = ["git", "commit", "--amend"],
    decision = "prompt",
    justification = "Amending rewrites the current commit; ask before running it.",
)

prefix_rule(
    pattern = ["git", "branch", "-D"],
    decision = "prompt",
    justification = "Force-deleting a branch can discard work; ask before running it.",
)

prefix_rule(
    pattern = ["git", "tag", "-d"],
    decision = "prompt",
    justification = "Deleting a Git tag changes history/release references; ask before running it.",
)

prefix_rule(
    pattern = ["git", "stash", "drop"],
    decision = "prompt",
    justification = "Dropping a stash can permanently discard saved work; ask before running it.",
)

prefix_rule(
    pattern = ["git", "push", "--force"],
    decision = "prompt",
    justification = "Force-push can rewrite remote history; ask before running it.",
)

prefix_rule(
    pattern = ["git", "push", "--force-with-lease"],
    decision = "prompt",
    justification = "Force-with-lease still rewrites remote history; ask before running it.",
)

prefix_rule(
    pattern = ["git", "push", "-f"],
    decision = "prompt",
    justification = "Short-form force-push can rewrite remote history; ask before running it.",
)

prefix_rule(
    pattern = ["git", "push", "--delete"],
    decision = "prompt",
    justification = "Deleting a remote ref requires explicit approval.",
)

# ---------------------------------------------------------------------------
# .NET: explicitly destructive database operation requires approval
# ---------------------------------------------------------------------------

prefix_rule(
    pattern = ["dotnet", "ef", "database", "drop"],
    decision = "prompt",
    justification = "Dropping a database is destructive and requires explicit approval.",
)

# ---------------------------------------------------------------------------
# PowerShell: destructive/process-changing commands require approval
# ---------------------------------------------------------------------------

prefix_rule(
    pattern = ["Remove-Item"],
    decision = "prompt",
    justification = "Removing files or directories can destroy work or user data; ask before running it.",
)

prefix_rule(
    pattern = ["Clear-Content"],
    decision = "prompt",
    justification = "Clearing file contents is destructive; ask before running it.",
)

prefix_rule(
    pattern = ["Stop-Process"],
    decision = "prompt",
    justification = "Stopping a process can disrupt user or system work; ask before running it.",
)

# ---------------------------------------------------------------------------
# GitHub CLI: sensitive/destructive administrative actions require approval
# ---------------------------------------------------------------------------

prefix_rule(
    pattern = ["gh", "repo", "delete"],
    decision = "prompt",
    justification = "Deleting a GitHub repository is destructive and requires explicit approval.",
)

prefix_rule(
    pattern = ["gh", "repo", "rename"],
    decision = "prompt",
    justification = "Renaming a repository changes remote identity and links; ask before running it.",
)

prefix_rule(
    pattern = ["gh", "repo", "transfer"],
    decision = "prompt",
    justification = "Transferring repository ownership is a high-impact action; ask before running it.",
)

prefix_rule(
    pattern = ["gh", "release", "delete"],
    decision = "prompt",
    justification = "Deleting a published release requires explicit approval.",
)

prefix_rule(
    pattern = ["gh", "secret"],
    decision = "prompt",
    justification = "GitHub secret operations affect credentials and require explicit approval.",
)

prefix_rule(
    pattern = ["gh", "api"],
    decision = "prompt",
    justification = "Raw GitHub API calls can bypass higher-level command safeguards; ask before running them.",
)
